<!doctype HTML>
<html>
	<head>
		<title>testando flexbox</title>
		<style>
			#teste_direto{
				border: solid 4px rgb(127, 127, 127);
				display: flex;
				flex-direction: row;
				width: 75%;
				
			}
			.item{
				border: solid 4px #00CCFF;
				padding: 5px;
				margin: 10px;
			}
			button{
				display: block;
				margin-top: 10px;
			}
		</style>
	</head>
	<body>
		<div id = "teste_direto">
			<p class="item">1</p>
			<p class="item">2</p>
			<p class="item">3</p>
			<p class="item">4</p>
			<p class="item">5</p>
		</div>
		<button onclick = "dobrarCaracteres()">click</button>
		<button onclick = "mudarDisplay()">click</button>
		<button onclick = "clearButton()">clear</button>
		<script>
			const teste_direto = document.querySelector("#teste_direto");
			const allItens = document.querySelectorAll(".item");
			let i = 0;
			function dobrarCaracteres(){
				allItens[0].innerHTML += " " + allItens[0].innerHTML;
				allItens[1].innerHTML += " " + allItens[1].innerHTML;
				allItens[2].innerHTML += " " + allItens[2].innerHTML;
				allItens[3].innerHTML += " " + allItens[3].innerHTML;
				allItens[4].innerHTML += " " + allItens[4].innerHTML;
			}
			function mudarDisplay(){
				switch(i){
					case 0:
						teste_direto.style.display = "row";
						i++
					break;
					case 1:
						teste_direto.style.display = "row-reverse";
						i++
					break;
					case 2:
						teste_direto.style.display = "column";
						i++
					break;
					case 3:
						teste_direto.style.display = "column-reverse";
						i++
					break;
					default:
						i = 0;
					break;
				}
			}
			function clearButton(){
				allItens[0].innerHTML = "1";
				allItens[1].innerHTML = "2";
				allItens[2].innerHTML = "3";
				allItens[3].innerHTML = "4";
				allItens[4].innerHTML = "5";
			}
		</script>
	</body>
</html>
